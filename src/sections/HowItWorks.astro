---
const wellnessCards = [
  {
    title: "Fitness",
    description: "Group classes, personal training, corporate fitness programs",
    icon: "/images/brain.svg",
    image: "/images/Focused-Strength-in-the-Gym_1Focused-Strength-in-the-Gym.webp",
  },
  {
    title: "Physiotherapy",
    description: "Massages, rehab, prevention, corporate sessions",
    icon: "/images/lightning.svg",
    image: "/images/Focused-Basketball-Player_1Focused-Basketball-Player.webp",
  },
  {
    title: "Mindfulness",
    description: "Meditation, breathwork, stress-reduction workshops",
    icon: "/images/chart-line-up.svg",
    image: "/images/Smiling-Athletic-Woman_1Smiling-Athletic-Woman.webp",
  },
  {
    title: "Active Breaks",
    description: "Short movement & ergonomic pauses in the workplace",
    icon: "/images/shield.svg",
    image: "/images/Gymnast-Mid-Performance_1Gymnast-Mid-Performance.webp",
  },
];

const steps = [
  {
    number: "01",
    title: "Transformative Experiences",
    description: "We don't just run activities. We design powerful experiences that leave a lasting impact and transform how teams connect, communicate, and grow together.",
  },
  {
    number: "02",
    title: "Challenges that Align Teams",
    description: "Through nature, movement, and shared challenges, we help teams strengthen trust, collaboration, and alignment toward common goals.",
  },
  {
    number: "03",
    title: "Well-being as the Key to Performance",
    description: "Our approach integrates fitness, physiotherapy, and mindfulness, helping people live, work, and lead at their best potential.",
  },
  {
    number: "04",
    title: "Tailor-Made Programs",
    description: "Every company and team is unique. We co-create personalized programs that adapt to your needs, culture, and objectives.",
  },
];
---

<section id="how-it-works" class="bg-[#0a0a0a] py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <!-- Wellness Options -->
    <div class="mb-24">
      <span class="section-badge">Evox Wellness</span>
      <h2
        data-reveal
        class="mt-6 text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
      >
        Explore Our Wellness Options
      </h2>

      <div data-stagger class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {wellnessCards.map((card) => (
          <div class="feature-card group relative overflow-hidden rounded-2xl border border-white/10 bg-[#161616] p-6 transition-all duration-300 hover:border-white/20">
            <!-- Hover image -->
            <div class="card-hover-img absolute inset-0 z-0">
              <img src={card.image} alt="" aria-hidden="true" class="h-full w-full object-cover" loading="lazy" />
              <div class="absolute inset-0 bg-black/60"></div>
            </div>

            <div class="relative z-10">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10">
                <img src={card.icon} alt="" aria-hidden="true" class="h-5 w-5 brightness-0 invert" />
              </div>
              <h3 class="text-[18px] font-bold text-white">{card.title}</h3>
              <p class="mt-2 text-[14px] leading-[1.6] text-white/60">{card.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- How It Works Steps -->
    <div>
      <span class="section-badge">How It Works</span>
      <h2
        data-reveal
        class="mt-6 max-w-2xl text-[36px] font-bold leading-[1.15] tracking-[-0.5px] text-white sm:text-[48px]"
      >
        Challenge the body, calm the mind, connect the team.
      </h2>

      <div data-stagger class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <div class="rounded-2xl border border-white/10 bg-[#161616] p-6">
            <span class="text-[13px] font-bold tracking-[2px] text-[#f37443]">{step.number}</span>
            <h3 class="mt-3 text-[17px] font-bold leading-[1.3] text-white">{step.title}</h3>
            <p class="mt-3 text-[14px] leading-[1.6] text-white/55">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
