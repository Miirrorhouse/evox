---
const testimonials = [
  {
    photo: "/images/Autumn-Scholarly-Cheer_1Autumn Scholarly Cheer.webp",
    quote: "I always focused on my physical training, thinking that was enough. Evox revealed the mental side — motivation, focus, mindset — and that's what changed my game. I now train smarter, not just harder.",
    name: "Bryan K",
    role: "Track Athlete",
  },
  {
    photo: "/images/Smiling-Professional-Woman_1Smiling Professional Woman.webp",
    quote: "Simple, quick, but so powerful. I've never had such clarity about my strengths and weaknesses. Being able to track my mindset, motivation, and confidence gives me real insight to push my limits safely and effectively.",
    name: "Alyssa P",
    role: "Tennis Player",
  },
  {
    photo: "/images/Professional-Portrait-of-a-Man_1Professional Portrait of a Man.webp",
    quote: "It felt like the program was describing me better than I could describe myself. Evox showed me patterns in my training habits and mental approach that I didn't realize. Now I know why I train the way I do, and how to stay consistent.",
    name: "Marcus R",
    role: "Swimmer",
  },
];
---

<section id="testimonials" class="bg-black py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <div class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="section-badge">Testimonials</span>
        <h2
          data-reveal
          class="mt-6 text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
        >
          What Our Members Say
        </h2>
      </div>
    </div>

    <div data-stagger class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {testimonials.map((t) => (
        <div class="rounded-2xl border border-white/10 bg-[#161616] p-6">
          <!-- Quote icon -->
          <svg width="28" height="24" viewBox="0 0 28 24" fill="#f37443" aria-hidden="true" class="mb-4 opacity-80">
            <path d="M0 24V14.4C0 10.56 0.96 7.36 2.88 4.8 4.96 2.08 7.84 0.48 11.52 0l1.44 2.16C10.4 2.8 8.72 3.84 7.44 5.28 6.16 6.72 5.44 8.32 5.28 10.08H9.6V24H0zm15.36 0V14.4c0-3.84.96-7.04 2.88-9.6C20.32 2.08 23.2.48 26.88 0l1.44 2.16c-2.56.64-4.24 1.68-5.52 3.12-1.28 1.44-2 3.04-2.16 4.8H25.6V24H15.36z"/>
          </svg>

          <p class="text-[15px] leading-[1.7] text-white/75 italic">"{t.quote}"</p>

          <div class="mt-6 flex items-center gap-3">
            <img
              src={t.photo}
              alt={t.name}
              class="h-10 w-10 rounded-full object-cover"
              loading="lazy"
            />
            <div>
              <p class="text-[14px] font-bold text-white">{t.name}</p>
              <p class="text-[12px] text-white/50">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
