---
const plans = [
  {
    id: "connection",
    name: "CONNECTION",
    duration: "3 meses",
    tagline: "Activación y primeros hábitos",
    description: "La base para equipos que necesitan volver a conectar con su energía, bienestar y dinámica grupal.",
    services: ["Fitness corporativo", "Workshops & mindfulness", "Fisioterapia"],
    outcomes: ["Aumento energía grupal", "Mejor clima laboral", "Más conexión"],
    featured: false,
    image: "/images/section8-conexion.jpg",
    imgPos: "object-[center_30%]",
  },
  {
    id: "transformation",
    name: "TRANSFORMATION",
    duration: "6 meses",
    tagline: "Consistencia y evolución",
    description: "Programas diseñados para mejorar el rendimiento, reducir el estrés y fortalecer la cohesión del equipo.",
    services: ["Fitness", "Fisioterapia", "Mindfulness & Workshops", "Pausas Activas", "Teambuilding"],
    outcomes: ["Equipos más focalizados", "Mejor rendimiento", "Menos estrés"],
    featured: true,
    image: "/images/section8-transformacion.jpg",
    imgPos: "object-center",
  },
  {
    id: "evolution",
    name: "EVOLUTION",
    duration: "12 meses",
    tagline: "Bienestar como cultura",
    description: "Integración profunda del bienestar dentro de la cultura organizacional.",
    services: ["Fitness", "Mindfulness & Workshops", "Fisioterapia", "Pausas activas", "Team building", "Seguimiento", "Evaluación continua", "Análisis de procesos"],
    outcomes: ["Cambio cultural real", "Menos absentismo", "Más productividad"],
    featured: false,
    image: "/images/section8-evolucion.jpg",
    imgPos: "object-center",
  },
];


---

<section id="pricing" class="bg-[#0a0a0a] py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <div class="text-center">
      <span data-i18n="pricing.badge" class="section-badge">Planes</span>
      <h2
        data-reveal
        data-i18n="pricing.title"
        class="mt-6 text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
      >
        Elige tu programa
      </h2>
      <p data-reveal data-i18n="pricing.subtitle" class="mx-auto mt-4 max-w-lg text-[17px] leading-[1.6] text-white/55">
        Cada programa es completamente personalizado. Cuéntanos sobre tu equipo y lo diseñamos juntos.
      </p>
    </div>

    <div data-stagger class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {plans.map((plan, i) => (
        <div
          class={`group relative flex flex-col rounded-2xl border transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.5)] ${
            plan.featured
              ? "border-[#f37443]/40 bg-[#1a0e0a]"
              : "border-white/10 bg-[#161616]"
          }`}
        >
          {plan.featured && (
            <span data-i18n="pricing.popularBadge" class="absolute -top-3.5 left-1/2 z-10 -translate-x-1/2 rounded-full bg-[#f37443] px-4 py-1 text-[11px] font-bold uppercase tracking-[1.5px] text-white">
              Más Popular
            </span>
          )}

          <!-- Photo -->
          <div class="relative h-44 overflow-hidden rounded-t-2xl">
            <img
              src={plan.image}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class={`h-full w-full object-cover ${plan.imgPos} transition-transform duration-700 group-hover:scale-105`}
            />
            <div class={`absolute inset-0 bg-gradient-to-b ${plan.featured ? "from-black/20 to-[#1a0e0a]" : "from-black/20 to-[#161616]"}`} />
          </div>

          <!-- Header -->
          <div class={`px-7 pt-6 pb-6 border-b ${plan.featured ? "border-[#f37443]/20" : "border-white/8"}`}>
            <div class="flex items-start justify-between gap-3">
              <h3 data-i18n={`pricing.plans.${i}.name`} class="text-[18px] font-bold uppercase tracking-[2px] text-white">{plan.name}</h3>
              <span data-i18n={`pricing.plans.${i}.duration`} class={`shrink-0 rounded-full px-3 py-1 text-[11px] font-bold tracking-[0.5px] ${plan.featured ? "bg-[#f37443]/20 text-[#f37443]" : "bg-white/8 text-white/40"}`}>
                {plan.duration}
              </span>
            </div>
            <p data-i18n={`pricing.plans.${i}.tagline`} class={`mt-1 text-[11px] font-medium uppercase tracking-[1.5px] ${plan.featured ? "text-[#f37443]/70" : "text-white/30"}`}>{plan.tagline}</p>
            <p data-i18n={`pricing.plans.${i}.description`} class="mt-4 text-[15px] leading-[1.65] text-white/65">{plan.description}</p>
          </div>

          <!-- Services -->
          <div class="px-7 py-6 flex-1">
            <p data-i18n="pricing.includes" class="mb-4 text-[10px] font-bold uppercase tracking-[2px] text-white/30">Incluye</p>
            <ul class="space-y-2.5">
              {plan.services.map((s, si) => (
                <li class="flex items-center gap-2.5">
                  <svg class={`shrink-0 h-3.5 w-3.5 ${plan.featured ? "text-[#f37443]" : "text-white/30"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span data-i18n={`pricing.plans.${i}.services.${si}`} class="text-[14px] text-white/65">{s}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Outcomes -->
          <div class={`mx-7 mb-6 rounded-xl px-5 py-4 ${plan.featured ? "bg-[#f37443]/10 border border-[#f37443]/20" : "bg-white/4 border border-white/8"}`}>
            <ul class="space-y-1.5">
              {plan.outcomes.map((o, oi) => (
                <li class="flex items-center gap-2">
                  <span class={`text-[13px] font-bold ${plan.featured ? "text-[#f37443]" : "text-white/35"}`}>→</span>
                  <span data-i18n={`pricing.plans.${i}.outcomes.${oi}`} class="text-[13px] font-medium text-white/70">{o}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA -->
          <div class="px-7 pb-7">
            <a
              href="#contact-form"
              class={`inline-flex w-full items-center justify-center rounded-full py-3.5 text-[14px] font-bold transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-px active:scale-[0.98] ${
                plan.featured
                  ? "bg-[#f37443] text-white hover:bg-[#ed4c22]"
                  : "border border-white/20 text-white hover:border-white/40 hover:bg-white/5"
              }`}
            >
              <span data-i18n="pricing.getStarted">Solicitar info</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact Form -->
    <div id="contact-form" data-reveal class="mt-20 rounded-2xl border border-white/10 bg-[#161616] p-8 lg:p-12">
      <div class="mb-10 text-center">
        <h3 data-i18n="pricing.form.title" class="text-[28px] font-bold text-white sm:text-[34px]">Obtén una Cotización Personalizada</h3>
        <p data-i18n="pricing.form.subtitle" class="mx-auto mt-3 max-w-md text-[15px] leading-[1.6] text-white/50">
          Cuéntanos sobre tu equipo y crearemos la experiencia perfecta para ti.
        </p>
      </div>

      <form action="#" method="POST" class="space-y-6">
        <!-- Row 1: Name + Company Size -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="form-name" data-i18n="pricing.form.name" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Nombre Completo</label>
            <input
              id="form-name"
              type="text"
              name="name"
              required
              data-i18n-placeholder="pricing.form.namePlaceholder"
              placeholder="Ana García"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="form-company-size" data-i18n="pricing.form.companySize" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Tamaño de la Empresa</label>
            <select
              id="form-company-size"
              name="company_size"
              required
              class="rounded-xl border border-white/10 bg-[#161616] px-4 py-3 text-[15px] text-white outline-none transition-colors duration-200 focus:border-[#f37443]/60 appearance-none cursor-pointer"
            >
              <option value="" disabled selected data-i18n-option="pricing.form.companySizePlaceholder">Selecciona el tamaño del equipo</option>
              <option value="1-10"   data-i18n-option="pricing.form.companySizeOptions.0">1–10 empleados</option>
              <option value="11-50"  data-i18n-option="pricing.form.companySizeOptions.1">11–50 empleados</option>
              <option value="51-200" data-i18n-option="pricing.form.companySizeOptions.2">51–200 empleados</option>
              <option value="201-500" data-i18n-option="pricing.form.companySizeOptions.3">201–500 empleados</option>
              <option value="500+"   data-i18n-option="pricing.form.companySizeOptions.4">500+ empleados</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Email + Phone -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="form-email" data-i18n="pricing.form.email" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Correo Electrónico</label>
            <input
              id="form-email"
              type="email"
              name="email"
              required
              data-i18n-placeholder="pricing.form.emailPlaceholder"
              placeholder="ana@empresa.com"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="form-phone" data-i18n="pricing.form.phone" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Número de Teléfono</label>
            <input
              id="form-phone"
              type="tel"
              name="phone"
              data-i18n-placeholder="pricing.form.phonePlaceholder"
              placeholder="+34 600 000 000"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-2">
          <label for="form-message" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">
            <span data-i18n="pricing.form.message">Mensaje</span>
            {" "}
            <span data-i18n="pricing.form.messageOptional" class="normal-case tracking-normal text-white/25">(opcional)</span>
          </label>
          <textarea
            id="form-message"
            name="message"
            rows="4"
            data-i18n-placeholder="pricing.form.messagePlaceholder"
            placeholder="Cuéntanos sobre los objetivos de tu equipo, fechas preferidas o cualquier pregunta que tengas…"
            class="resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="flex justify-end pt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-2.5 rounded-full bg-[#f37443] px-10 py-4 text-[15px] font-bold text-white transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:bg-[#ed4c22] hover:-translate-y-px active:translate-y-0 active:scale-[0.98]"
          >
            <span data-i18n="pricing.form.submit">Enviar Mi Consulta</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

  </div>
</section>
