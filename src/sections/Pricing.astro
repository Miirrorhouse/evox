---
const packages = [
  { name: "Connection",     description: "Half-day experience — snacks, group dynamics, activities like hiking & paddle surf.", featured: false, ikey: "pricing.packages.0" },
  { name: "Evolution",      description: "2–4 day retreat — full transport, lodging, food, fitness & mindfulness workshops, adventure activities.", featured: true, ikey: "pricing.packages.1" },
  { name: "Transformation", description: "Full-day experience — meals, transfers, group dynamics, activities like via ferrata, kayak & rafting.", featured: false, ikey: "pricing.packages.2" },
];

const services = ["Outdoor Experiences", "Team Training", "Team Mindfulness", "Retreats"];
---

<section id="pricing" class="bg-[#0a0a0a] py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <div class="text-center">
      <span data-i18n="pricing.badge" class="section-badge">Pricing Plans</span>
      <h2
        data-reveal
        data-i18n="pricing.title"
        class="mt-6 text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
      >
        Start Your Journey
      </h2>
      <p data-reveal data-i18n="pricing.subtitle" class="mx-auto mt-4 max-w-lg text-[17px] leading-[1.6] text-white/55">
        Packages start at $5k. Every program is fully custom — reach out and we'll build the right experience for your team.
      </p>
    </div>

    <div data-stagger class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {packages.map((pkg) => (
        <div
          class={`relative flex flex-col rounded-2xl border p-8 transition-transform duration-300 hover:-translate-y-1 ${
            pkg.featured
              ? "border-[#f37443]/50 bg-[#1a0e0a]"
              : "border-white/10 bg-[#161616]"
          }`}
        >
          {pkg.featured && (
            <span data-i18n="pricing.popularBadge" class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-[#f37443] px-4 py-1 text-[11px] font-bold uppercase tracking-[1.5px] text-white">
              Most Popular
            </span>
          )}

          <h3 data-i18n={`${pkg.ikey}.name`} class="text-[22px] font-bold text-white">{pkg.name}</h3>
          <p data-i18n={`${pkg.ikey}.desc`} class="mt-3 text-[14px] leading-[1.6] text-white/55">{pkg.description}</p>

          <div class="mt-6 border-t border-white/10 pt-6">
            <p data-i18n="pricing.allCustom" class="text-[13px] font-semibold uppercase tracking-[1.5px] text-white/40">All Plans Completely Custom</p>
          </div>

          <div class="mt-6">
            <a
              href="#contact-form"
              class={`inline-flex w-full items-center justify-center rounded-full py-3 text-[15px] font-bold transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-px active:scale-[0.98] ${
                pkg.featured
                  ? "bg-[#f37443] text-white hover:bg-[#ed4c22]"
                  : "border border-white/20 text-white hover:border-white/40 hover:bg-white/5"
              }`}
            >
              <span data-i18n="pricing.getStarted">Get Started</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact Form -->
    <div id="contact-form" data-reveal class="mt-20 rounded-2xl border border-white/10 bg-[#161616] p-8 lg:p-12">
      <div class="mb-10 text-center">
        <h3 data-i18n="pricing.form.title" class="text-[28px] font-bold text-white sm:text-[34px]">Get a Custom Quote</h3>
        <p data-i18n="pricing.form.subtitle" class="mx-auto mt-3 max-w-md text-[15px] leading-[1.6] text-white/50">
          Tell us about your team and we'll craft the perfect experience for you.
        </p>
      </div>

      <form action="#" method="POST" class="space-y-6">
        <!-- Row 1: Name + Company Size -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="form-name" data-i18n="pricing.form.name" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Full Name</label>
            <input
              id="form-name"
              type="text"
              name="name"
              required
              data-i18n-placeholder="pricing.form.namePlaceholder"
              placeholder="Jane Smith"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="form-company-size" data-i18n="pricing.form.companySize" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Company Size</label>
            <select
              id="form-company-size"
              name="company_size"
              required
              class="rounded-xl border border-white/10 bg-[#161616] px-4 py-3 text-[15px] text-white outline-none transition-colors duration-200 focus:border-[#f37443]/60 appearance-none cursor-pointer"
            >
              <option value="" disabled selected data-i18n-option="pricing.form.companySizePlaceholder">Select team size</option>
              <option value="1-10"   data-i18n-option="pricing.form.companySizeOptions.0">1–10 employees</option>
              <option value="11-50"  data-i18n-option="pricing.form.companySizeOptions.1">11–50 employees</option>
              <option value="51-200" data-i18n-option="pricing.form.companySizeOptions.2">51–200 employees</option>
              <option value="201-500" data-i18n-option="pricing.form.companySizeOptions.3">201–500 employees</option>
              <option value="500+"   data-i18n-option="pricing.form.companySizeOptions.4">500+ employees</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Email + Phone -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="form-email" data-i18n="pricing.form.email" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Email Address</label>
            <input
              id="form-email"
              type="email"
              name="email"
              required
              data-i18n-placeholder="pricing.form.emailPlaceholder"
              placeholder="jane@company.com"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="form-phone" data-i18n="pricing.form.phone" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">Phone Number</label>
            <input
              id="form-phone"
              type="tel"
              name="phone"
              data-i18n-placeholder="pricing.form.phonePlaceholder"
              placeholder="+1 (555) 000-0000"
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
            />
          </div>
        </div>

        <!-- Service Selection -->
        <div class="flex flex-col gap-3">
          <span data-i18n="pricing.form.interested" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">I'm Interested In</span>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {services.map((service, i) => (
              <label class="group flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 transition-colors duration-200 has-[:checked]:border-[#f37443]/60 has-[:checked]:bg-[#f37443]/10">
                <input
                  type="checkbox"
                  name="services"
                  value={service}
                  class="hidden"
                />
                <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-white/20 bg-transparent transition-colors duration-200 group-has-[:checked]:border-[#f37443] group-has-[:checked]:bg-[#f37443]">
                  <svg class="h-2.5 w-2.5 text-white opacity-0 transition-opacity duration-200 group-has-[:checked]:opacity-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span data-i18n={`pricing.form.services.${i}`} class="text-[13px] font-medium text-white/70 transition-colors duration-200 group-has-[:checked]:text-white">{service}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-2">
          <label for="form-message" class="text-[13px] font-semibold uppercase tracking-[1.2px] text-white/40">
            <span data-i18n="pricing.form.message">Message</span>
            {" "}
            <span data-i18n="pricing.form.messageOptional" class="normal-case tracking-normal text-white/25">(optional)</span>
          </label>
          <textarea
            id="form-message"
            name="message"
            rows="4"
            data-i18n-placeholder="pricing.form.messagePlaceholder"
            placeholder="Tell us about your team's goals, preferred dates, or any questions you have…"
            class="resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[15px] text-white placeholder:text-white/25 outline-none transition-colors duration-200 focus:border-[#f37443]/60 focus:bg-white/8"
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="flex justify-end pt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-2.5 rounded-full bg-[#f37443] px-10 py-4 text-[15px] font-bold text-white transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:bg-[#ed4c22] hover:-translate-y-px active:translate-y-0 active:scale-[0.98]"
          >
            <span data-i18n="pricing.form.submit">Send My Inquiry</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

  </div>
</section>
