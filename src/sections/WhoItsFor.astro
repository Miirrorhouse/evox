---
const cards = [
  {
    title: "Empresas y Organizaciones",
    description: "Para startups hasta grandes empresas, coworkings, sedes corporativas — retiros, programas de cultura y bienestar.",
    image: "/images/Cyclists-Determination_1Cyclists Determination.webp",
    ikey: "whoItsFor.cards.0",
  },
  {
    title: "Instituciones Educativas",
    description: "Para universidades, escuelas de negocios, institutos, academias — campamentos de orientación, días de liderazgo y resiliencia.",
    image: "/images/Focused-Athlete-Outdoors_1Focused Athlete Outdoors.webp",
    ikey: "whoItsFor.cards.1",
  },
  {
    title: "Sector Público y Sin Fines de Lucro",
    description: "Para municipios, ONGs, organizaciones comunitarias — cohesión de equipo, prevención del burnout, bienestar comunitario.",
    image: "/images/Dynamic-Athleticism-in-Motion_1Dynamic Athleticism in Motion.webp",
    ikey: "whoItsFor.cards.2",
  },
];
---

<section id="who-its-for" class="bg-black py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <div class="text-center">
      <span data-i18n="whoItsFor.badge" class="section-badge">Para Quién</span>
      <h2
        data-reveal
        data-i18n="whoItsFor.title"
        class="mt-6 text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
      >
        Tu Equipo nos Importa
      </h2>
    </div>

    <div data-stagger class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {cards.map((card) => (
        <div class="group relative overflow-hidden rounded-2xl">
          <div class="aspect-[3/4] w-full overflow-hidden">
            <img
              src={card.image}
              alt={card.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 data-i18n={`${card.ikey}.title`} class="text-[20px] font-bold leading-tight text-white">{card.title}</h3>
            <p data-i18n={`${card.ikey}.desc`} class="mt-2 text-[14px] leading-[1.5] text-white/65">{card.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
