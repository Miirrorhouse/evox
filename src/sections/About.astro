---
const images = [
  { src: "/images/Athletic-Woman-Close-Up_1Athletic Woman Close-Up.webp", alt: "Athletic woman close up" },
  { src: "/images/nastuh-abootalebi-yWwob8kwOCk-unsplash_1nastuh-abootalebi-yWwob8kwOCk-unsplash.webp", alt: "Wellness activity" },
  { src: "/images/Woman-with-Tennis-Racket_1Woman with Tennis Racket.webp", alt: "Woman with tennis racket" },
  { src: "/images/nastuh-abootalebi-yWwob8kwOCk-unsplash_16960c292402437378098ab5374425a12_nastuh-abootalebi-yWwob8kwOCk-unsplash.webp", alt: "Athlete outdoors" },
];
---

<section id="about" class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <!-- Text block -->
    <div data-stagger="loose" class="mx-auto max-w-3xl text-center">
      <span class="inline-block rounded-full border border-[#f37443] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[3px] text-[#f37443]">about EVOX</span>
      <h2
        class="mt-4 text-[36px] font-normal leading-[1.2] tracking-[-0.5px] text-[#111] sm:text-[48px] lg:text-[56px]"
      >
        Real Transformation Always<br class="hidden sm:block" /> Starts from Within
      </h2>
      <p class="mt-6 text-[16px] leading-[1.5] text-[#555]">
        At Evox we design experiences that move people. We blend adventure and wellness to reconnect teams
        and individuals with their bodies, their essence, and nature. Through hiking, paddle and kayak outings,
        via ferrata, retreats, fitness, physiotherapy, and mindfulness, we turn challenge into clarity, trust,
        and lasting growth. Whether you need a half-day reset or a multi-day evolution, our programs are
        tailor-made and fully supported end to end. Come for the activity, leave with stronger connection,
        better performance, and a healthier culture.
      </p>
    </div>

  </div>

  <!-- Image strip — overflows the section edges intentionally -->
  <div class="relative mt-16 overflow-hidden" id="about-img-track-wrap">
    <div
      id="about-img-track"
      class="flex gap-4 mx-auto will-change-transform"
      style="width: max-content;"
    >
      {images.map((img) => (
        <div
          class="shrink-0 overflow-hidden rounded-2xl aspect-[3/4]"
          style="width: calc((100vw - 3rem) * 0.295);"
        >
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById("about");
    var track = document.getElementById("about-img-track");
    if (!section || !track) return;

    // The track is wider than the viewport — calculate the overflow amount
    // so we can use it as the travel distance.
    var ticking = false;

    // How far (in px) the track travels left-to-right as the section scrolls
    // through the viewport. Positive = right shift at bottom, negative at top.
    var TRAVEL = 120; // px — adjust if you want more or less movement

    function applyParallax() {
      var rect = section.getBoundingClientRect();
      var viewH = window.innerHeight;

      // progress: 0 when section first enters at bottom, 1 when it exits at top
      var progress = 1 - rect.bottom / (viewH + rect.height);
      progress = Math.max(0, Math.min(1, progress));

      // Translate from -TRAVEL/2 (start left) → +TRAVEL/2 (end right)
      var offset = (progress - 0.5) * TRAVEL;
      track.style.transform = "translateX(" + offset + "px)";

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(applyParallax);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    applyParallax();
  })();
</script>
