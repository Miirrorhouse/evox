---
const logos = [
  { src: "/images/logos/Benevity_logo.svg.png",         alt: "Benevity",      large: false },
  { src: "/images/logos/Gemini-Logo-New.png",           alt: "Gemini",        large: true  },
  { src: "/images/logos/aticco_logo.png",               alt: "Aticco",        large: false },
  { src: "/images/logos/binance_logo.png",              alt: "Binance",       large: false },
  { src: "/images/logos/ef-logo.png",                   alt: "EF",            large: true  },
  { src: "/images/logos/nal_3 logo.png",                alt: "NAL",           large: false, sm: true },
  { src: "/images/logos/oncowork_logo.svg",             alt: "Oncowork",      large: false },
  { src: "/images/logos/primal_state_gmbh_logo.jpeg",  alt: "Primal State",  large: true, xl: true  },
  { src: "/images/logos/ridcardo_b_logo.png",           alt: "Ridcardo B",    large: false },
  { src: "/images/logos/Soho_House_logo.jpg",           alt: "Soho House",    large: false },
];

const images = [
  { src: "/images/Athletic-Woman-Close-Up_1Athletic Woman Close-Up.webp", alt: "Athletic woman close up" },
  { src: "/images/nastuh-abootalebi-yWwob8kwOCk-unsplash_1nastuh-abootalebi-yWwob8kwOCk-unsplash.webp", alt: "Wellness activity" },
  { src: "/images/Woman-with-Tennis-Racket_1Woman with Tennis Racket.webp", alt: "Woman with tennis racket" },
  { src: "/images/nastuh-abootalebi-yWwob8kwOCk-unsplash_16960c292402437378098ab5374425a12_nastuh-abootalebi-yWwob8kwOCk-unsplash.webp", alt: "Athlete outdoors" },
];

const problems = [
  {
    num: "01",
    titleKey: "about.p1title",
    bodyKey: "about.p1body",
    title: "Burnout silencioso",
    body: "Equipos funcionando en automático, con menos energía, foco y motivación.",
  },
  {
    num: "02",
    titleKey: "about.p2title",
    bodyKey: "about.p2body",
    title: "Desconexión humana",
    body: "Menos presencia. Menos colaboración real. Más distancia entre las personas.",
  },
  {
    num: "03",
    titleKey: "about.p3title",
    bodyKey: "about.p3body",
    title: "Creatividad bloqueada",
    body: "Cuando el estrés domina, el rendimiento y las buenas ideas empiezan a desaparecer.",
  },
  {
    num: "04",
    titleKey: "about.p4title",
    bodyKey: "about.p4body",
    title: "Cultura desgastada",
    body: "Las personas no abandonan empresas. Abandonan entornos donde dejaron de sentirse vivas.",
  },
];
---

<section id="about" class="bg-white pt-10 pb-24 lg:pt-12 lg:pb-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <!-- Logos -->
    <p data-reveal class="mb-8 text-center text-[12px] font-semibold uppercase tracking-[3px] text-[#bbb]">
      Empresas que confían en EVOX
    </p>
    <div data-reveal class="grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
      {logos.map((logo) => (
        <div class="flex items-center justify-center">
          <img
            src={logo.src}
            alt={logo.alt}
            loading="lazy"
            class={`w-auto object-contain opacity-80 transition-opacity duration-300 hover:opacity-100 ${logo.xl ? "max-h-[4.5rem] max-w-[210px]" : logo.large ? "max-h-14 max-w-[160px]" : logo.sm ? "max-h-8 max-w-[104px]" : "max-h-10 max-w-[130px]"}`}
          />
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="my-20 h-px bg-[#ebebeb]"></div>

    <!-- Badge -->
    <div data-reveal class="flex justify-center">
      <span data-i18n="about.badge" class="inline-block rounded-full border border-[#f37443] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[3px] text-[#f37443]">sobre EVOX</span>
    </div>

    <!-- Headline -->
    <h2
      data-reveal
      data-i18n="about.title"
      class="mt-4 text-center text-[36px] font-normal leading-[1.2] tracking-[-0.5px] text-[#111] sm:text-[48px] lg:text-[56px]"
    >
      El problema no es el talento.
    </h2>

    <!-- Subtitle -->
    <p
      data-reveal
      data-i18n="about.subtitle"
      class="mx-auto mt-5 max-w-xl text-center text-[18px] leading-[1.6] text-[#888]"
    >
      Es el entorno en el que las personas viven y trabajan.
    </p>

    <!-- Problem grid -->
    <div data-stagger class="mt-16 grid grid-cols-1 gap-px bg-[#e8e8e8] border border-[#e8e8e8] rounded-2xl overflow-hidden sm:grid-cols-2">
      {problems.map((p) => (
        <div class="group relative bg-white px-8 py-10 lg:px-10 lg:py-12 transition-colors duration-300 hover:bg-[#faf9f7]">
          <!-- Number -->
          <span class="block text-[11px] font-bold tracking-[3px] uppercase text-[#ccc] mb-4">{p.num}</span>

          <!-- Divider -->
          <div class="mb-5 h-px w-10 bg-[#f37443] transition-all duration-500 group-hover:w-16"></div>

          <!-- Title -->
          <h3
            data-i18n={p.titleKey}
            class="text-[22px] font-semibold leading-[1.25] tracking-[-0.3px] text-[#111] lg:text-[26px]"
          >
            {p.title}
          </h3>

          <!-- Body -->
          <p
            data-i18n={p.bodyKey}
            class="mt-3 text-[15px] leading-[1.65] text-[#666]"
          >
            {p.body}
          </p>
        </div>
      ))}
    </div>

  </div>

  <!-- Image strip -->
  <div class="relative mt-20 overflow-hidden" id="about-img-track-wrap">
    <div
      id="about-img-track"
      class="flex gap-4 mx-auto will-change-transform"
      style="width: max-content;"
    >
      {images.map((img) => (
        <div
          class="shrink-0 overflow-hidden rounded-2xl aspect-[3/4]"
          style="width: calc((100vw - 3rem) * 0.295);"
        >
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById("about");
    var track = document.getElementById("about-img-track");
    if (!section || !track) return;

    var ticking = false;
    var TRAVEL = 120;

    function applyParallax() {
      var rect = section.getBoundingClientRect();
      var viewH = window.innerHeight;
      var progress = 1 - rect.bottom / (viewH + rect.height);
      progress = Math.max(0, Math.min(1, progress));
      var offset = (progress - 0.5) * TRAVEL;
      track.style.transform = "translateX(" + offset + "px)";
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(applyParallax);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    applyParallax();
  })();
</script>
