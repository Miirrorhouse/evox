---
const benefits = [
  {
    title: "Results You Can Trust",
    description: "We stand by our method: if the agreed objectives are not met, we refund your investment. That's our confidence and commitment to your success.",
    icon: "/images/brain.svg",
    image: "/images/Focused-Strength-in-the-Gym_1Focused-Strength-in-the-Gym.webp",
  },
  {
    title: "End-to-End Logistics",
    description: "From transport and food to lodging, materials, and expert coaches, we take care of everything — you focus only on enjoying the experience.",
    icon: "/images/lightning.svg",
    image: "/images/Focused-Basketball-Player_1Focused-Basketball-Player.webp",
  },
  {
    title: "Expertise with Heart",
    description: "With over 10 years of experience in health, fitness, and adventure, Evox combines professional knowledge with authentic passion for people.",
    icon: "/images/chart-line-up.svg",
    image: "/images/Smiling-Athletic-Woman_1Smiling-Athletic-Woman.webp",
  },
  {
    title: "Building Conscious Communities",
    description: "We don't just develop individuals or teams — we help create healthier, more resilient, and conscious communities that evolve together.",
    icon: "/images/shield.svg",
    image: "/images/Gymnast-Mid-Performance_1Gymnast-Mid-Performance.webp",
  },
];
---

<section id="benefits" class="bg-[#0a0a0a] py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">

    <span class="section-badge">Benefits</span>
    <h2
      data-reveal
      class="mt-6 max-w-xl text-[36px] font-bold leading-[1.1] tracking-[-0.5px] text-white sm:text-[48px]"
    >
      Trust The Full Capabilities of Our Skilled Team
    </h2>

    <div data-stagger class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map((item) => (
        <div class="feature-card group relative overflow-hidden rounded-2xl border border-white/10 bg-[#161616] p-6 transition-all duration-300 hover:border-white/20">
          <!-- Hover image -->
          <div class="card-hover-img absolute inset-0 z-0">
            <img src={item.image} alt="" aria-hidden="true" class="h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-black/65"></div>
          </div>

          <div class="relative z-10">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10">
              <img src={item.icon} alt="" aria-hidden="true" class="h-5 w-5 brightness-0 invert" />
            </div>
            <h3 class="text-[17px] font-bold leading-tight text-white">{item.title}</h3>
            <p class="mt-3 text-[14px] leading-[1.6] text-white/60">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
