---
---

<section
  id="hero"
  class="relative flex min-h-[100dvh] flex-col overflow-hidden"
  data-parallax-section
>
  <div class="absolute inset-0 z-0" data-parallax-bg>
    <video
      class="hero-img h-full w-full object-cover object-center will-change-transform"
      style="transform-origin: center center;"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src="/images/hero-bg.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/20 to-black/30" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-black to-transparent" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 items-center justify-center px-6 pt-8 pb-8 lg:px-12 will-change-transform" data-parallax-content>
    <div class="flex w-full flex-col items-center text-center">

      <!-- Trust badge -->
      <div
        class="hero-animate inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-sm"
        style="animation-delay: 0.1s;"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="#f37443" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span class="text-[13px] font-semibold text-white">4.8 rating &nbsp;|&nbsp; 50,000+ members</span>
      </div>

      <!-- Headline -->
      <h1
        class="hero-animate mt-5 text-[52px] font-bold leading-[0.95] tracking-[-1px] text-white sm:text-[68px] lg:text-[88px]"
        style="animation-delay: 0.2s;"
      >
        Evolve Wild.<br />
        <span style="color: #f37443;">Live Consciously.</span>
      </h1>

      <!-- Subheadline -->
      <p
        class="hero-animate mt-6 max-w-2xl text-[18px] font-normal leading-[1.55] text-white/80"
        style="animation-delay: 0.35s;"
      >
        At Evox, every experience is rooted in the body and movement — because real transformation happens when people step out of their comfort zone and into action.
      </p>

      <!-- CTA -->
      <div class="hero-animate mt-10" style="animation-delay: 0.5s;">
        <a
          href="#pricing"
          class="group inline-flex items-center gap-2.5 rounded-full bg-[#f37443] px-8 py-3.5 text-[16px] font-bold text-white transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:bg-[#ed4c22] hover:-translate-y-px active:translate-y-0 active:scale-[0.98]"
        >
          Begin My Journey
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[250ms] group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector("[data-parallax-section]");
    var bg = section && section.querySelector("[data-parallax-bg] video, [data-parallax-bg] img");
    var content = section && section.querySelector("[data-parallax-content]");
    if (!section || !bg || !content) return;

    var ticking = false;

    function applyParallax() {
      var rect = section.getBoundingClientRect();
      // Only run while the section is in view
      if (rect.bottom < 0 || rect.top > window.innerHeight) {
        ticking = false;
        return;
      }
      // progress: 0 at top of viewport, 1 when section scrolls fully out at top
      var progress = -rect.top / rect.height;
      // Background moves down (positive Y) — slower than scroll
      bg.style.transform = "translateY(" + (progress * 35) + "%) scale(1.15)";
      // Text moves up — subtle, half the rate
      content.style.transform = "translateY(" + (progress * -12) + "%)";
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(applyParallax);
        ticking = true;
      }
    }

    // Set initial scale so there's room to pan without revealing edges
    bg.style.transform = "translateY(0%) scale(1.15)";

    window.addEventListener("scroll", onScroll, { passive: true });
    applyParallax();
  })();
</script>
