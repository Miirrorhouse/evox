---
---

<section
  id="hero"
  class="relative flex min-h-[100dvh] flex-col overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <img
      src="/images/61.jpg"
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-black to-transparent" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 items-end px-6 pb-20 pt-8 lg:px-12 lg:pb-28">
    <div class="flex w-full flex-col lg:max-w-2xl">

      <!-- Trust badge -->
      <div
        class="hero-animate inline-flex items-center gap-2 self-start rounded-full border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-sm"
        style="animation-delay: 0.1s;"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="#f37443" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span class="text-[13px] font-semibold text-white">4.8 rating &nbsp;|&nbsp; 50,000+ members</span>
      </div>

      <!-- Headline -->
      <h1
        class="hero-animate mt-5 text-[52px] font-bold leading-[0.95] tracking-[-1px] text-white sm:text-[68px] lg:text-[88px]"
        style="animation-delay: 0.2s;"
      >
        Evolve Wild.<br />
        <span style="color: #f37443;">Live Consciously.</span>
      </h1>

      <!-- Subheadline -->
      <p
        class="hero-animate mt-6 max-w-xl text-[18px] font-normal leading-[1.55] text-white/80"
        style="animation-delay: 0.35s;"
      >
        At Evox, every experience is rooted in the body and movement — because real transformation happens when people step out of their comfort zone and into action.
      </p>

      <!-- CTA -->
      <div class="hero-animate mt-10" style="animation-delay: 0.5s;">
        <a
          href="#pricing"
          class="group inline-flex items-center gap-2.5 rounded-full bg-[#f37443] px-8 py-3.5 text-[16px] font-bold text-white transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:bg-[#ed4c22] hover:-translate-y-px active:translate-y-0 active:scale-[0.98]"
        >
          Begin My Journey
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[250ms] group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
