---
---

<section id="contact" class="relative overflow-hidden py-32 lg:py-40">
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/Dynamic-Stride-on-Red-Athletic-Track_1Dynamic Stride on Red Athletic Track.webp"
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-6 text-center lg:px-12">
    <span data-i18n="cta.badge" class="section-badge mx-auto">Get In Touch</span>
    <h2
      data-reveal
      data-i18n-html="cta.title"
      class="mx-auto mt-6 max-w-2xl text-[40px] font-bold leading-[1.05] tracking-[-0.5px] text-white sm:text-[56px] lg:text-[68px]"
    >
      Take Control of<br />Your Mindset Today
    </h2>
    <p data-reveal data-i18n="cta.subtitle" class="mx-auto mt-5 max-w-lg text-[17px] leading-[1.6] text-white/70">
      Start your self-discovery journey in minutes and unlock your full potential.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        data-reveal
        href="mailto:hello@evox.com"
        class="group inline-flex items-center gap-2.5 rounded-full bg-[#f37443] px-10 py-4 text-[16px] font-bold text-white transition-all duration-[250ms] [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:bg-[#ed4c22] hover:-translate-y-px active:translate-y-0 active:scale-[0.98]"
      >
        <span data-i18n="cta.button">Begin My Journey</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[250ms] group-hover:translate-x-1" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
